---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Artifact Studio" noindex>
  <section class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="font-body text-4xl">Page not found</h1>
    <p class="mt-4">
      That page doesn't exist. Head back to the
      <a href="/" class="underline">homepage</a> or
      <a href="/contact" class="underline">get in touch</a>.
    </p>
  </section>
</Layout>